# 生产环境配置

# 项目部署路径（打包后的 base 路径）
VITE_BASE_URL=/ca/

# API 前缀（生产环境直接使用后端地址）
VITE_API_PREFIX=http://172.16.2.41:8086/ca

# API 代理目标地址
VITE_API_PROXY_TARGET=http://172.16.2.41:8086/ca

# SSO 服务端地址
VITE_SSO_URL=http://172.16.2.41:8085/sso/login

# SSO 客户端ID
VITE_SSO_CLIENT_ID=1000

# 应用标题
VITE_APP_TITLE=统一身份认证系统

# SSO 登录成功后的回调地址
VITE_REDIRECT_URI=http://172.16.2.41:8086/bg-manage/index.html#/
