# 开发环境配置

# 项目部署路径（开发环境使用根路径）
VITE_BASE_URL=/

# API 前缀（开发环境通过代理转发，去掉前缀后转发到后端）
VITE_API_PREFIX=/api

# API 代理目标地址（本地 CA 日志后台）
VITE_API_PROXY_TARGET=http://localhost:8087

# SSO 服务端地址（本地 SSO）
VITE_SSO_URL=http://localhost:8085/sso/login

# SSO 客户端ID
VITE_SSO_CLIENT_ID=1000

# 应用标题
VITE_APP_TITLE=统一身份认证系统

# 应用端口
VITE_PORT=3000

# SSO 登录成功后的回调地址
VITE_REDIRECT_URI=http://localhost:3000/
